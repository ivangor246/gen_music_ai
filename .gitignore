# Rust build artifacts
/target

# Large model weights and soundfont. Small model configs remain tracked so a
# fresh clone can compile before the runtime assets are downloaded.
/models/*
!/models/catalog.json
!/models/midi-model-tv2o-medium/
/models/midi-model-tv2o-medium/*
!/models/midi-model-tv2o-medium/config.json
!/models/midi-model-tv2o-medium/generation_config.json
!/models/midi-gpt-yellow/
/models/midi-gpt-yellow/*
!/models/midi-gpt-yellow/encoder.json
/assets/soundfont.sf2

# Backup files
**/*.rs.bk

